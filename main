#!/bin/bash
set -euo pipefail
export PYTHONUNBUFFERED=1
rm -f secondary-archive-result.json
if [[ -z "${SECONDARY_ARCHIVE_S3_BUCKET:-}" ]]; then
    exec python3 ./legacy_archive.py
fi
export BRAINLIFE_ARCHIVE_S3FS_BUCKET="${BRAINLIFE_ARCHIVE_S3FS_BUCKET:-$SECONDARY_ARCHIVE_S3_BUCKET}"
# Keep staged sibling task directories visible inside the transfer container.
binds=(--bind "$(dirname "$PWD")")
source_mount="${BRAINLIFE_ARCHIVE_s3fs:-/mnt/s3fs}"
if [[ -d "$source_mount" ]]; then
    binds+=(--bind "$source_mount:$source_mount:ro")
fi
singularity exec "${binds[@]}" docker://brainlife/archive:s3fs-s5cmd-v1     env PYTHONPATH=/opt/archive-zarr-sdk python3 -S ./secondary_archive.py
python3 ./finish_secondary.py
echo "Secondary archive completed successfully"
